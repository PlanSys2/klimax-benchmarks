(define (problem cellar-2-problem)
 (:domain cellar-2-domain)
 (:objects
   match0 match1 match2 - match
   fuse0 fuse1 - fuse
 )
 (:htn
  :subtasks (and
    (_t311 (fix fuse0))
    (_t312 (fix fuse1)))
  :ordering (and
    ))
 (:init
              (= (burns match0) 6)
              (= (burns match1) 6)
              (= (burns match2) 6)
              (unused match0)
              (unused match1)
              (unused match2)
              (handfree)
 )
 (:goal (and 
           (mended fuse0)
           (mended fuse1)
        )
 )
)
