(define (problem cellar-3-problem)
 (:domain cellar-3-domain)
 (:objects
   match0 match1 match2 match3 - match
   fuse0 fuse1 fuse2 - fuse
 )
 (:htn
  :subtasks (and
    (_t315 (fix fuse0))
    (_t316 (fix fuse1))
    (_t317 (fix fuse2)))
  :ordering (and
    ))
 (:init
              (= (burns match0) 7)
              (= (burns match1) 7)
              (= (burns match2) 8)
              (= (burns match3) 9)
              (unused match0)
              (unused match1)
              (unused match2)
              (unused match3)
              (handfree)
 )
 (:goal (and 
           (mended fuse0)
           (mended fuse1)
           (mended fuse2)
        )
 )
)
