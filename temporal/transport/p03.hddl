(define (problem transport-3-problem)
 (:domain transport-3-domain)
 (:objects
   truck0 truck1 - truck
   place0 place1 place2 place3 place4 - place
   package0 package1 package2 package3 - package
 )
 (:htn
  :subtasks (and
    (_t24 (deliver package0 place3))
    (_t25 (deliver package1 place1))
    (_t26 (deliver package2 place4))
    (_t27 (deliver package3 place3)))
  :ordering (and
    ))
 (:init
              (road place0 place2)
              (= (road-length place0 place2) 3)
              (road place2 place0)
              (= (road-length place2 place0) 3)
              (road place2 place3)
              (= (road-length place2 place3) 2)
              (road place3 place2)
              (= (road-length place3 place2) 2)
              (road place3 place4)
              (= (road-length place3 place4) 9)
              (road place4 place3)
              (= (road-length place4 place3) 9)
              (road place4 place1)
              (= (road-length place4 place1) 5)
              (road place1 place4)
              (= (road-length place1 place4) 5)
              (truck-at truck0 place3)
              (truck-at truck1 place4)
              (package-at package0 place4)
              (package-at package1 place3)
              (package-at package2 place1)
              (package-at package3 place4)
              (= (road-length place0 place0) 1)
              (= (road-length place1 place0) 1)
              (= (road-length place3 place0) 1)
              (= (road-length place4 place0) 1)
              (= (road-length place0 place1) 1)
              (= (road-length place1 place1) 1)
              (= (road-length place2 place1) 1)
              (= (road-length place3 place1) 1)
              (= (road-length place1 place2) 1)
              (= (road-length place2 place2) 1)
              (= (road-length place4 place2) 1)
              (= (road-length place0 place3) 1)
              (= (road-length place1 place3) 1)
              (= (road-length place3 place3) 1)
              (= (road-length place0 place4) 1)
              (= (road-length place2 place4) 1)
              (= (road-length place4 place4) 1)
 )
 (:goal (and 
           (package-at package0 place3)
           (package-at package1 place1)
           (package-at package2 place4)
           (package-at package3 place3)
        )
 )
)
