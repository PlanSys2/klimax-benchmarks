(define (problem workshop-2-problem)
 (:domain workshop-2-domain)
 (:objects
   machine0 machine1 - machine
   piece0 piece1 piece2 - piece
 )
 (:htn
  :subtasks (and
    (_t227 (make piece0))
    (_t228 (make piece1))
    (_t229 (make piece2)))
  :ordering (and
    ))
 (:init
              (first piece0 machine0)
              (second piece0 machine1)
              (= (time_ piece0 machine0) 2)
              (= (time_ piece0 machine1) 6)
              (first piece1 machine0)
              (second piece1 machine1)
              (= (time_ piece1 machine0) 5)
              (= (time_ piece1 machine1) 4)
              (first piece2 machine0)
              (second piece2 machine1)
              (= (time_ piece2 machine0) 7)
              (= (time_ piece2 machine1) 7)
              (free machine0)
              (free machine1)
 )
 (:goal (and 
           (done piece0 machine1)
           (done piece1 machine1)
           (done piece2 machine1)
        )
 )
)
