    (_t238 (make piece0))
    (_t239 (make piece1))
    (_t240 (make piece2))
    (_t241 (make piece3))
    (_t242 (make piece4)))
  :ordering (and
    ))
 (:init
              (first piece0 machine0)
              (second piece0 machine1)
              (= (time_ piece0 machine0) 2)
              (= (time_ piece0 machine1) 7)
              (first piece1 machine1)
              (second piece1 machine0)
              (= (time_ piece1 machine1) 2)
              (= (time_ piece1 machine0) 2)
              (first piece2 machine0)
              (second piece2 machine1)
              (= (time_ piece2 machine0) 9)
              (= (time_ piece2 machine1) 5)
              (first piece3 machine0)
              (second piece3 machine2)
              (= (time_ piece3 machine0) 9)
              (= (time_ piece3 machine2) 9)
              (first piece4 machine1)
              (second piece4 machine2)
              (= (time_ piece4 machine1) 3)
              (= (time_ piece4 machine2) 2)
              (free machine0)
              (free machine1)
              (free machine2)
              (= (time_ piece4 machine0) 1)
              (= (time_ piece3 machine1) 1)
              (= (time_ piece0 machine2) 1)
              (= (time_ piece1 machine2) 1)
              (= (time_ piece2 machine2) 1)
 )
 (:goal (and 
